# Copier ce fichier vers .env sur le serveur (jamais committé) et renseigner les valeurs.
# Les contenus visibles (nom du site, coordonnées, destinataire des demandes, textes, etc.) se règlent
# dans l'interface d'administration, pas ici. Ce fichier ne contient que l'infrastructure et les secrets.

# --- Application ---
# production | local
APP_ENV=production
# true uniquement en local (ignoré en production)
APP_DEBUG=false
# URL publique complète, sans slash final (utilisée pour les liens canoniques, le sitemap et robots.txt)
APP_URL=https://www.example.com
# Chaîne aléatoire de 64 caractères : php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_KEY=
# Langue par défaut de secours (la valeur active se règle dans Administration > Réglages)
APP_DEFAULT_LOCALE=fr
APP_TIMEZONE=Europe/Paris
# true seulement derrière un proxy/CDN de confiance (Cloudflare...) qui fournit X-Forwarded-For/Proto
TRUST_PROXY_HEADERS=false

# --- Base de données MySQL / MariaDB ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- E-mail (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
# tls (STARTTLS, port 587) | ssl (port 465) | none
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Persomy
# Destinataire de secours si aucun destinataire n'est défini dans Administration > Réglages
MAIL_TO=

# --- Téléversements ---
UPLOAD_MAX_MB=5
